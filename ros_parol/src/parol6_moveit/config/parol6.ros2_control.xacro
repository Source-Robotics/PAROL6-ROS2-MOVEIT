<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="parol6_ros2_control"
                 params="name initial_positions_file use_real_hardware:=false bridge_host:=127.0.0.1 bridge_port:=6001">
        <xacro:property name="initial_positions" value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${use_real_hardware}">
                    <!-- Talks to a parol6_bridge daemon (TCP loopback), which in turn
                         talks to parol6-server over UDP using the parol6 Python SDK.
                         See parol6_hardware_interface and parol6_bridge packages, and
                         launch/real_robot.launch.py. -->
                    <plugin>parol6_hardware_interface/Parol6SystemInterface</plugin>
                    <param name="bridge_host">${bridge_host}</param>
                    <param name="bridge_port">${bridge_port}</param>
                    <param name="connect_timeout_sec">10.0</param>
                </xacro:if>
                <xacro:unless value="${use_real_hardware}">
                    <!-- Default: simulation only, no real robot involved. -->
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:unless>
            </hardware>
            <joint name="L1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="L2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="L3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="L4">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="L5">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="L6">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['L6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>
